<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<NoWarn>NU1903</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture.Idioms" Version="4.18.1"/>
		<!--<PackageReference Include="Bogus" Version="35.6.5"/>-->
		<PackageReference Include="CompareNETObjects" Version="4.84.0"/>
		<PackageReference Include="coverlet.collector" Version="6.0.4">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.msbuild" Version="6.0.4">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Fixie.TestAdapter" Version="4.2.0"/>
		<PackageReference Include="Inflector.NetStandard" Version="1.2.2"/>
		<PackageReference Include="SerilogTimings" Version="3.1.0"/>
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2"/>
		<PackageReference Include="Serilog.Sinks.TextWriter" Version="3.0.0"/>
		<PackageReference Include="xunit.v3.assert" Version="3.2.0"/>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit"/>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="../Shared/**/*.cs"/>
	</ItemGroup>
</Project>
