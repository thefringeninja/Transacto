<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<PackageReference Include="NodaTime" Version="3.3.0"/>
		<PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.3.1"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Transacto.Schemo\Transacto.Schemo.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
	</ItemGroup>

	<ItemGroup>
		<!-- Don't include the output from a previous source generator execution into future runs; the */** trick here ensures that there's
		at least one subdirectory, which is our key that it's coming from a source generator as opposed to something that is coming from
		some other tool. -->
		<Compile Remove="$(CompilerGeneratedFilesOutputPath)/*/**/*.cs"/>
		<None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="**\*.schema.json">
			<DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.schema', '.cs'))</DependentUpon>
			<!-- DependentUpon changes the manifest resource name to the dependent class's name, which collides
			when both a .schema.json and .uischema.json exist; LogicalName restores the path-based name. -->
			<LogicalName>$(RootNamespace).$([System.String]::Copy('%(RelativeDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="**\*.uischema.json">
			<DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.uischema', '.cs'))</DependentUpon>
			<LogicalName>$(RootNamespace).$([System.String]::Copy('%(RelativeDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<AdditionalFiles Include="**\*.schema.json"/>
		<CompilerVisibleProperty Include="RootNamespace"/>
		<CompilerVisibleProperty Include="MSBuildProjectDirectory" />
	</ItemGroup>

</Project>
