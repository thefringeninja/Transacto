{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"title": "Accounting Period Closed",
	"additionalProperties": false,
	"required": [
		"closingGeneralLedgerEntryId",
		"generalLedgerEntryIds"
	],
	"properties": {
		"closingGeneralLedgerEntryId": {
			"title": "Closing General Ledger Entry Id",
			"$ref": "Uuid.schema.json",
			"x-schema-form": {
				"key": "vendorId",
				"type": "uuid"
			}
		},
		"generalLedgerEntryIds": {
			"title": "General Ledger Entry Ids",
			"type": "array",
			"items": {
				"$ref": "Uuid.schema.json"
			}
		},
		"period": {
			"title": "Period",
			"type": "string",
			"pattern": "^[0-9]{6}$"
		},
		"balance": {
			"type": "array",
			"items": {
				"$ref": "BalanceLineItem.schema.json"
			}
		}
	},
	"definitions": {
		"uuid": {
			"type": "string",
			"pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
			"format": "uuid"
		}
	}
}
