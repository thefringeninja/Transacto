{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"title": "Define Account",
	"additionalProperties": false,
	"required": [
		"accountName",
		"accountNumber",
		"cashFlowCategory"
	],
	"properties": {
		"accountName": {
			"title": "Account Name",
			"type": "string"
		},
		"accountNumber": {
			"title": "Account Number",
			"type": "integer"
		},
		"cashFlowCategory": {
			"title": "Cash Flow Category Type",
			"type": "string",
			"enum": ["operations", "investment", "finance"]
		},
		"affectsCash" : {
			"title": "Affects Cash",
			"type": "boolean",
			"default": false
		}
	}
}
