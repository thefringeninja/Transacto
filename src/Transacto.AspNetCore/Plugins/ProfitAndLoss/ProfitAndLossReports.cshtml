@using NodaTime
@using NodaTime.Text
@using Transacto.Framework.Http.Html
@using Transacto.Plugins.ProfitAndLoss
@inherits Transacto.Framework.Http.Html.TransactoRazorEngine.View<ProfitAndLossReports>
@{
	Layout = "Layout.cshtml";

	var colspan = Model.Reports.Length + 1;
}

<table>
	@{
		<thead>
		<tr>
			<th colspan="@colspan">Profit and Loss</th>
		</tr>
		<tr>
			<th></th>
			@foreach (var report in Model.Reports)
			{
				<th>@LocalDatePattern.Iso.Format(report.ReportRange.StartingOn) - @PeriodPattern.NormalizingIso.Format(report.ReportRange.Period)</th>
			}
		</tr>
		</thead>
		RenderReportSection("Revenue",
			Model.GrossRevenueAccountNumbers, report => report.TotalGrossRevenue);
		RenderReportSection("Cost of Revenue",
			Model.CostOfRevenueAccountNumbers, report => report.TotalCostOfRevenue);
		RenderSubtotal("Gross Profit", report => report.GrossProfit);

		RenderReportSection("Operating Expenses", Model.OperatingExpenseAccountNumbers, report => report.TotalOperatingExpenses);

		RenderSubtotal("Operating Income", report => report.OperatingIncome);

		RenderReportSection("Other Expenses", Model.OtherExpenseAccountNumbers, report => report.TotalOtherExpenses);
		RenderReportSection("Other Income", Model.OtherIncomeAccountNumbers, report => report.TotalOtherIncome);
		RenderSubtotal("Net Profit", report => report.NetProfit);
		<tfoot>
		<tr>
		</tr>
		</tfoot>}
</table>

@{
	void RenderReportSection(
		string name,
		IEnumerable<int> accountNumbers,
		Func<ProfitAndLossReport, decimal> getSubtotal)
	{
		<thead>
		<tr>
			<th colspan="@colspan">@name</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var accountNumber in accountNumbers)
		{
			<tr>
				<td>@accountNumber - @Model.Accounts[accountNumber]</td>
				@foreach (var report in Model.Reports)
				{
					<td style="text-align: right">@Tags.FormatAmount(report.GetBalance(accountNumber))</td>
				}
			</tr>
		}
		<tr>
			<td>Total @name</td>
			@foreach (var report in Model.Reports)
			{
				<td style="text-align: right">@Tags.FormatAmount(getSubtotal(report))</td>
			}
		</tr>
		</tbody>
	}

	void RenderSubtotal(string name, Func<ProfitAndLossReport, decimal> getSubtotal)
	{
		<tbody>
		<tr>
			<td>@name</td>
			@foreach (var report in Model.Reports)
			{
				<td style="text-align: right">@Tags.FormatAmount(getSubtotal(report))</td>
			}
		</tr>
		</tbody>
		
	}
}
