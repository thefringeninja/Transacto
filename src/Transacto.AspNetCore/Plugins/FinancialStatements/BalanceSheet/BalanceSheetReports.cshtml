@using NodaTime.Text
@using Transacto.Framework.Http.Html
@using Transacto.Plugins.FinancialStatements.BalanceSheet
@inherits Transacto.Framework.Http.Html.TransactoRazorEngine.View<BalanceSheetReports>
@{
	Layout = "Layout.cshtml";

	var colspan = Model.Reports.Length + 1;
}

<table>
	@{
		<thead>
		<tr>
			<th colspan="@colspan"><h1>Balance Sheet Report</h1></th>
		</tr>
		<tr>
			<th></th>
			@foreach (var report in Model.Reports)
			{
				<th>@LocalDatePattern.Iso.Format(report.Thru)</th>
			}
		</tr>
		</thead>
		ReportSection("Assets",
			Model.AssetAccountNumbers, report => report.TotalAssets);
		ReportSection("Liabilities",
			Model.LiabilityAccountNumbers, report => report.TotalLiabilities);
		ReportSection("Equity",
			Model.EquityAccountNumbers, report => report.TotalEquity, true);

		<tfoot>
		<tr>
			<td>Total Equity &amp; Liabilities</td>
			@foreach (var report in Model.Reports)
			{
				<td style="text-align: right">@Tags.FormatAmount(report.TotalEquityAndLiabilities)</td>
			}
		</tr>
		</tfoot>}
</table>

@{
	void ReportSection(
		string name,
		IEnumerable<int> accountNumbers,
		Func<BalanceSheetReport, decimal> getSubtotal,
		bool includeIncomeSummary = false)
	{
		<thead>
		<tr>
			<th colspan="@colspan">@name</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var accountNumber in accountNumbers)
		{
			<tr>
				<td>@accountNumber - @Model.Accounts[accountNumber]</td>
				@foreach (var report in Model.Reports)
				{
					<td style="text-align: right">@Tags.FormatAmount(report.GetBalance(accountNumber))</td>
				}
			</tr>
		}
		@if (includeIncomeSummary)
		{
			<tr>
				<td>Income Summary</td>
				@foreach (var report in Model.Reports)
				{
					<td style="text-align: right">@Tags.FormatAmount(report.IncomeSummary)</td>
				}
			</tr>
		}
		<tr>
			<td>Total @name</td>
			@foreach (var report in Model.Reports)
			{
				<td style="text-align: right">@Tags.FormatAmount(getSubtotal(report))</td>
			}
		</tr>
		</tbody>
	}
}
