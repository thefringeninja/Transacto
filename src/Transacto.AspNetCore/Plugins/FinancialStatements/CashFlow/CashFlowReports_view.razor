@using Transacto.Framework.Http.Html
@using Transacto.Views.Shared
@inherits ComponentBase<CashFlowReports>
@inject FormatSettings formatSettings
@{
	var colspan = Model.Groups.Length + 1;
}

<LayoutView Layout="typeof(Layout)">
	<table>
		<thead>
		<tr>
			<th colspan="@colspan"><h1>Cash Flow</h1></th>
		</tr>
		<tr>
			<th></th>
			@foreach (var report in Model.Groups) {
				<th>@formatSettings.ShortDatePattern.Format(report.ReportRange.StartingOn)</th>
			}
		</tr>
		</thead>

		@{
			RenderReportSummary("Cash, Start of Period", report => report.StartingCash);
			RenderReportSummary("Net Income", report => report.NetIncome);
			RenderReportSection(nameof(ReportGroup.Operations), Model.AccountMap.Operations, report => report.Operations);
			RenderReportSection(nameof(ReportGroup.Investment), Model.AccountMap.Investment, report => report.Investment);
			RenderReportSection(nameof(ReportGroup.Finance), Model.AccountMap.Finance, report => report.Finance);
			RenderReportSummary("Cash, End of Period", report => report.EndingCash);
		}

		<tfoot>
		<tr>
		</tr>
		</tfoot>
	</table>

	@{
		void RenderReportSection(
			string category,
			IDictionary<int, string> accounts,
			Func<ReportGroup, Report> getReport,
			Func<ReportGroup, decimal>? getSubtotal = null) {
			<thead>
			@{
				getSubtotal ??= group => getReport(group).Total;
			}
			<tr>
				<th colspan="@colspan">Cash Flow from @category</th>
			</tr>
			</thead>
			<tbody>
			@foreach (var (accountNumber, accountName) in accounts) {
				<tr>
					<td>@accountNumber - @accountName</td>
					@foreach (var reportGroup in Model.Groups) {
						<td style="text-align: right">
							@if (getReport(reportGroup).Lines.TryGetValue(accountNumber, out var line)) {
								<Balance Value="@line.Balance"/>
							} else {
								<Balance Value=0m />
							}
						</td>
					}
				</tr>
			}
			<tr>
				<td>Net Cash from @category</td>
				@foreach (var report in Model.Groups) {
					<td style="text-align: right">
						<Balance Value="@getSubtotal(report)"/>
					</td>
				}
			</tr>
			</tbody>
		}

		void RenderReportSummary(
			string name,
			Func<ReportGroup, decimal> getSubtotal) {
			<tbody>
			<tr>
				<td>@name</td>
				@foreach (var report in Model.Groups) {
					<td style="text-align: right">
						<Balance Value="@getSubtotal(report)"/>
					</td>
				}
			</tr>
			</tbody>
		}
	}
</LayoutView>
