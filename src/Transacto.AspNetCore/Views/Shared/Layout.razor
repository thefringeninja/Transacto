@using Microsoft.AspNetCore.Components.Sections
@using Transacto.Framework.Http
@inherits LayoutComponentBase
@inject ViewContext context
<!DOCTYPE html>
<html>
<head>
	<style type="text/css">
		table {
			border-spacing: 0;
		}
		td {
			padding: 5pt;
		}
		/* Style for even rows */
		tbody tr:nth-child(even) {
			background-color: #f2f2f2; /* Light gray for even rows */
		}

		/* Style for odd rows (optional, if you want a different color for odd rows) */
		tbody tr:nth-child(odd) {
			background-color: #ffffff; /* White for odd rows */
		}
	</style>
	<SectionOutlet SectionName="head" />
</head>
<body>
<header>
	<section>
		@{
			foreach (var link in context._links)
			{
				<a href="@link.Href" rel="@link.Rel" name="@link.Name" hreflang="@link.HrefLang"
				   title="@link.Title">@link.Title</a>
			}
		}
	</section>
</header>
<main>
	@Body
</main>
</body>
</html>
