@using System.Text.Json
@using Microsoft.AspNetCore.Components.Sections
@using Transacto.Views.Shared
@inherits ComponentBase<dynamic>
<LayoutView Layout="typeof(Layout)">

	@foreach (JsonElement schema in Model.forms)
	{
		<div id="@schema.GetProperty("$id").GetString()"></div>
	}

	<script language="javascript" type="module">
		import {createRoot} from "react-dom/client"
		import {jsx} from "react/jsx-runtime";
		import Form from "@@rjsf/mui";
		import validator from "@@rjsf/validator-ajv8";

		const schemata = JSON.parse("@JsonSerializer.Serialize(Model.forms, SerializerOptions)");

		for (const i in schemata) {
			const schema = schemata[i];
			const container = document.getElementById(schema.$id);
			const root = createRoot(container);

			const onSubmit = async ({formData}) => {
				const props = {schema, validator, onSubmit, formData};
				root.render(
					jsx(Form, {...props, disabled: true})
				);

				const body = new FormData();
				body.append("command", schema.$id);
				body.append('blob', new Blob([
					JSON.stringify(formData)
				]));
				var response = await fetch('.', {
					method: "POST",
					body,
				});

				if (response.status < 400) {
					root.render(
						jsx(Form, {...props, formData: undefined})
					);
					return;
				}

				const errorText = await response.text();
				const extraErrors = {
					__errors: [`${response.status} - ${response.statusText}`, errorText],
				}

				root.render(
					jsx(Form, {...props, extraErrors})
				);

			};

			root.render(
				jsx(Form, {schema, validator, onSubmit})
			)
		}

	</script>

</LayoutView>

<SectionContent SectionName="head">

	<script type="importmap">
		{
					"imports": {
						"react": "https://esm.sh/react@@@react",
						"react-dom": "https://esm.sh/react-dom@@@react",
						"react-dom/client": "https://esm.sh/react-dom@@@react/client",
						"react/jsx-runtime": "https://esm.sh/react@@@react/jsx-runtime",
						"@@rjsf/core": "https://esm.sh/@@rjsf/core@@@rjsf?deps=react@@@react,react-dom@@@react",
						"@@rjsf/validator-ajv8": "https://esm.sh/@@rjsf/validator-ajv8@@@rjsf?deps=react@@@react",
						"@@rjsf/mui": "https://esm.sh/@@rjsf/mui@@@rjsf?deps=react@@@react,react-dom@@@react"
					}
				}
	</script>
</SectionContent>

@code{
	private const string react = "18.3.1";
	private const string rjsf = "6.1.2";

	private static JsonSerializerOptions SerializerOptions = new()
	{
		WriteIndented = false
	};

}
