<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<OutputType>exe</OutputType>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<RootNamespace>SomeCompany</RootNamespace>
		<NoWarn>NU1903</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Ductus.FluentDocker" Version="2.85.0" />
		<PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0"/>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" GeneratePathProperty="true" PrivateAssets="all"/>
		<PackageReference Include="SharpCompress" Version="0.50.7"/>
		<PackageReference Include="SqlStreamStore.Http" Version="1.2.1-*"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\src\Transacto.Schemo\Transacto.Schemo.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\src\Projac\src\Projac.Npgsql\Projac.Npgsql.csproj"/>
		<ProjectReference Include="..\..\..\..\src\Transacto.AspNetCore\Transacto.AspNetCore.csproj"/>
		<ProjectReference Include="..\..\..\..\src\Transacto\Transacto.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="**\*.sql"/>
		<None Remove="node_modules\**"/>
		<EmbeddedResource Remove="node_modules\**"/>
		<Compile Remove="node_modules\**"/>
		<Content Update="*.db" Watch="false"/>
	</ItemGroup>

	<ItemGroup>
		<Schemo Include="Inventory\**\*.schema.json" Namespace="SomeCompany.Inventory"/>

		<Schemo Include="PurchaseOrders\**\*.schema.json" Namespace="SomeCompany.PurchaseOrders"/>

		<Schemo Include="ReceiptOfGoods\**\*.schema.json" Namespace="SomeCompany.ReceiptOfGoods"/>

	</ItemGroup>

	<Import Project="..\..\..\..\src\Transacto.Schemo\build\Transacto.Schemo.targets"/>

</Project>
